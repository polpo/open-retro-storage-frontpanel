menu "Product Configuration"

    choice PRODUCT_TYPE
        prompt "Product type"
        default PRODUCT_PICOIDE
        help
            Select the product type for branding and feature configuration.

        config PRODUCT_PICOIDE
            bool "PicoIDE"
            help
                Build for PicoIDE product.

        config PRODUCT_BLUESCSI
            bool "BlueSCSI"
            help
                Build for BlueSCSI product.
    endchoice

    config MAX_DEVICES
        int
        default 8 if PRODUCT_BLUESCSI
        default 2 if PRODUCT_PICOIDE

    choice HOST_TRANSPORT
        prompt "Host communication transport"
        default HOST_TRANSPORT_AUTO if PRODUCT_BLUESCSI
        default HOST_TRANSPORT_SPI
        help
            Physical link used to talk to the host main board. BlueSCSI
            auto-detects it at boot (v2 uses I2C, Ultra/Ultra Wide use SPI)
            and persists the last transport a live main board answered on in
            NVS; PicoIDE always uses SPI. The forced SPI/I2C options exist for
            debugging a single transport.

        config HOST_TRANSPORT_AUTO
            bool "Auto-detect (SPI or I2C)"
            depends on PRODUCT_BLUESCSI
            help
                Probe for the main board on both transports at boot and
                remember the one that answered, so one BlueSCSI binary covers
                v2 (I2C) and Ultra/Ultra Wide (SPI).

        config HOST_TRANSPORT_SPI
            bool "SPI (forced)"
            help
                10 MHz SPI master (BlueSCSI Ultra/Ultra Wide, PicoIDE).

        config HOST_TRANSPORT_I2C
            bool "I2C (forced)"
            help
                1 MHz I2C master (BlueSCSI v2).
    endchoice

    config PANEL_TEST_HOOKS
        bool "Enable panel test hooks"
        default n
        help
            Adds /api/button, /api/ui and /api/screen so a bench harness can
            press buttons and read back the screen, menu cursor and framebuffer.
            Off in shipping builds: it is a remote control surface for the UI.

endmenu
